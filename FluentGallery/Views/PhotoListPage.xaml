<Page
    x:Class="FluentGallery.Views.PhotoListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentGallery.ViewModels"
    xmlns:conv="using:FluentGallery.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Photo thumbnail card -->
        <DataTemplate x:Key="PhotoCardTemplate" x:DataType="vm:PhotoItemViewModel">
            <Grid>
                <!-- Layer 1: background placeholder icon (always present; covered by image when loaded) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        Glyph="&#xEB9F;"
                        FontSize="28"
                        Opacity="0.2"/>
                </Border>

                <!-- Layer 2: thumbnail image (covers placeholder when source is set) -->
                <Image
                    Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                    Stretch="UniformToFill"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Layer 3: loading overlay (shown while thumbnail is being generated) -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Opacity="0.7"
                    Visibility="{x:Bind IsLoading, Mode=OneWay,
                                         Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing
                        IsActive="{x:Bind IsLoading, Mode=OneWay}"
                        Width="28" Height="28"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Album title / inline rename -->
            <RowDefinition Height="Auto"/> <!-- CommandBar toolbar -->
            <RowDefinition Height="*"/>    <!-- Photo grid -->
        </Grid.RowDefinitions>

        <!-- ── Inline rename TextBox (only visible during rename) ── -->
        <Grid Grid.Row="0"
              Padding="20 8 20 4"
              Visibility="{x:Bind ViewModel.IsRenamingAlbum, Mode=OneWay,
                                   Converter={StaticResource BoolToVisibility}}">
            <TextBox
                x:Name="AlbumRenameBox"
                Text="{x:Bind ViewModel.EditAlbumName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                FontSize="20"
                FontWeight="SemiBold"
                BorderThickness="0 0 0 2"
                Background="Transparent"
                KeyDown="AlbumRenameBox_KeyDown"
                LostFocus="AlbumRenameBox_LostFocus"/>
        </Grid>

        <!-- ── Toolbar ── -->
        <CommandBar
            Grid.Row="1"
            DefaultLabelPosition="Right"
            Background="Transparent"
            OverflowButtonVisibility="Collapsed">

            <!-- Add photos -->
            <AppBarButton
                x:Name="AddPhotosButton"
                Icon="Add"
                Label="添加照片"
                Click="AddPhotos_Click"/>

            <!-- Delete (enabled only in multi-select mode with ≥1 selection) -->
            <AppBarButton
                x:Name="DeleteButton"
                Icon="Delete"
                Label="删除"
                Click="Delete_Click"
                IsEnabled="{x:Bind ViewModel.IsMultiSelectMode, Mode=OneWay}"/>

            <!-- Move to album -->
            <AppBarButton
                x:Name="MoveToAlbumButton"
                Icon="MoveToFolder"
                Label="移到相册"
                IsEnabled="{x:Bind ViewModel.IsMultiSelectMode, Mode=OneWay}"
                Click="MoveToAlbum_Click"/>

            <AppBarSeparator/>

            <!-- Rename album -->
            <AppBarButton
                x:Name="RenameAlbumButton"
                Icon="Rename"
                Label="重命名"
                Click="RenameAlbum_Click"/>

            <!-- Sort -->
            <AppBarButton Icon="Sort" Label="排序">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="SortFlyout" Opening="SortFlyout_Opening">
                        <RadioMenuFlyoutItem x:Name="SortByName"       Text="文件名"   GroupName="PhotoSort" Tag="Name"       Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A5;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortBySize"       Text="文件大小" GroupName="PhotoSort" Tag="Size"       Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8C8;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortByCreated"    Text="创建时间" GroupName="PhotoSort" Tag="CreatedAt"  Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74E;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortByModified"   Text="修改时间" GroupName="PhotoSort" Tag="ModifiedAt" Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortByTakenAt"    Text="拍摄时间" GroupName="PhotoSort" Tag="TakenAt"    Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE722;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <ToggleMenuFlyoutItem
                            x:Name="SortDescToggle"
                            Text="升序"
                            Click="SortDescToggle_Click">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74A;"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <!-- Multi-select toggle -->
            <AppBarToggleButton
                x:Name="MultiSelectToggle"
                Label="多选"
                IsChecked="{x:Bind ViewModel.IsMultiSelectMode, Mode=OneWay}"
                Click="MultiSelectToggle_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE762;"/>
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>

            <AppBarSeparator/>

            <!-- Zoom in / out -->
            <AppBarButton
                x:Name="ZoomInButton"
                Label="放大"
                IsEnabled="{x:Bind ViewModel.CanZoomIn, Mode=OneWay}"
                Click="ZoomInButton_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A3;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="ZoomOutButton"
                Label="缩小"
                IsEnabled="{x:Bind ViewModel.CanZoomOut, Mode=OneWay}"
                Click="ZoomOutButton_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE71F;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator/>

            <!-- Search within this album -->
            <AppBarButton
                x:Name="SearchButton"
                Label="搜索"
                Click="Search_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE721;"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- ── Photo grid ── -->
        <GridView
            x:Name="PhotoGridView"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Photos}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="PhotoGridView_ItemClick"
            ContainerContentChanging="PhotoGridView_ContainerContentChanging"
            SizeChanged="PhotoGridView_SizeChanged"
            ManipulationMode="Scale,System"
            ManipulationDelta="PhotoGridView_ManipulationDelta"
            PointerWheelChanged="PhotoGridView_PointerWheelChanged"
            Padding="4 0 4 24">

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        ItemWidth="180"
                        ItemHeight="180"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Padding"       Value="0"/>
                    <Setter Property="Margin"        Value="2"/>
                    <Setter Property="CornerRadius"  Value="6"/>
                    <Setter Property="MinWidth"      Value="0"/>
                    <Setter Property="MinHeight"     Value="0"/>
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <StaticResource ResourceKey="PhotoCardTemplate"/>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Loading overlay -->
        <ProgressRing
            Grid.Row="2"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48" Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon
                FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                Glyph="&#xEB9F;"
                FontSize="64"
                Opacity="0.3"/>
            <TextBlock
                Text="相册中还没有照片"
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <TextBlock
                Text="点击「添加照片」将照片加入此相册"
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyTextBlockStyle}"
                Opacity="0.6"/>
        </StackPanel>

        <!-- Card size toast overlay -->
        <Border x:Name="CardSizeToast"
                Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="20,10" CornerRadius="8"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="CardSizeToastText"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Border>
    </Grid>
</Page>
