<Page
    x:Class="FluentGallery.Views.PhotoListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentGallery.ViewModels"
    xmlns:conv="using:FluentGallery.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Photo thumbnail card -->
        <DataTemplate x:Key="PhotoCardTemplate" x:DataType="vm:PhotoItemViewModel">
            <Grid>
                <ToolTipService.ToolTip>
                    <StackPanel MaxWidth="320" Spacing="2">
                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" TextWrapping="WrapWholeWords"/>
                        <TextBlock Text="{x:Bind TakenAtTooltipText, Mode=OneWay}" Opacity="0.6"/>
                        <TextBlock Text="{x:Bind FileSizeFormatted, Mode=OneWay}" Opacity="0.6"/>
                        <TextBlock Text="{x:Bind ResolutionFormatted, Mode=OneWay}" Opacity="0.6"/>
                    </StackPanel>
                </ToolTipService.ToolTip>
                <!-- Layer 1: background placeholder icon (always present; covered by image when loaded) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        Glyph="&#xEB9F;"
                        FontSize="28"
                        Opacity="0.2"/>
                </Border>

                <!-- Layer 2: thumbnail image (covers placeholder when source is set) -->
                <Image
                    Source="{x:Bind ThumbnailSource, Mode=OneWay}"
                    Stretch="UniformToFill"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Layer 3: loading overlay (shown while thumbnail is being generated) -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Opacity="0.7"
                    Visibility="{x:Bind IsLoading, Mode=OneWay,
                                         Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing
                        IsActive="{x:Bind IsLoading, Mode=OneWay}"
                        Width="28" Height="28"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- CommandBar toolbar -->
            <RowDefinition Height="*"/>    <!-- Photo grid -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            Background="Transparent"
            OverflowButtonVisibility="Collapsed">

            <AppBarButton
                x:Name="SelectAllButton"
                x:Uid="PhotoList_SelectAllButton"
                Label="全选"
                Visibility="Collapsed"
                Click="SelectAll_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8B3;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="DeleteButton"
                x:Uid="PhotoList_DeleteButton"
                Icon="Delete"
                Label="删除"
                Click="Delete_Click"
                Visibility="Collapsed"/>
            <AppBarButton
                x:Name="MoveButton"
                x:Uid="PhotoList_MoveButton"
                Icon="MoveToFolder"
                Label="移动"
                Visibility="Collapsed"
                Click="MovePhotos_Click"/>
            <AppBarButton
                x:Name="CopyButton"
                x:Uid="PhotoList_CopyButton"
                Label="复制"
                Visibility="Collapsed"
                Click="CopyPhotos_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8C8;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator x:Name="BatchCommandSeparator" Visibility="Collapsed"/>

            <!-- Sort -->
            <AppBarButton x:Name="SortButton" x:Uid="PhotoList_SortButton" Icon="Sort" Label="排序">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="SortFlyout" Opening="SortFlyout_Opening">
                        <RadioMenuFlyoutItem x:Name="SortByName" x:Uid="PhotoList_SortByName" Text="文件名" GroupName="PhotoSort" Tag="Name" Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A5;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortBySize" x:Uid="PhotoList_SortBySize" Text="文件大小" GroupName="PhotoSort" Tag="Size" Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8C8;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortByCreated" x:Uid="PhotoList_SortByCreated" Text="创建时间" GroupName="PhotoSort" Tag="CreatedAt" Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74E;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortByModified" x:Uid="PhotoList_SortByModified" Text="修改时间" GroupName="PhotoSort" Tag="ModifiedAt" Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortByTakenAt" x:Uid="PhotoList_SortByTakenAt" Text="拍摄时间" GroupName="PhotoSort" Tag="TakenAt" Click="SortMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE722;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <RadioMenuFlyoutItem x:Name="SortAscendingItem" Text="升序" GroupName="PhotoSortDirection" Tag="Ascending" Click="SortDirectionMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74A;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SortDescendingItem" Text="降序" GroupName="PhotoSortDirection" Tag="Descending" Click="SortDirectionMenuItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74B;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarToggleButton
                x:Name="MultiSelectToggle"
                x:Uid="PhotoList_MultiSelectToggle"
                Label="多选"
                IsChecked="{x:Bind ViewModel.IsMultiSelectMode, Mode=OneWay}"
                Click="MultiSelectToggle_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE762;"/>
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>

            <AppBarSeparator/>

            <!-- Zoom in / out -->
            <AppBarButton
                x:Name="ZoomInButton"
                x:Uid="PhotoList_ZoomInButton"
                Label="放大"
                IsEnabled="{x:Bind ViewModel.CanZoomIn, Mode=OneWay}"
                Click="ZoomInButton_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A3;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="ZoomOutButton"
                x:Uid="PhotoList_ZoomOutButton"
                Label="缩小"
                IsEnabled="{x:Bind ViewModel.CanZoomOut, Mode=OneWay}"
                Click="ZoomOutButton_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE71F;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator/>

            <!-- Search within this album -->
            <AppBarButton
                x:Name="SearchButton"
                x:Uid="PhotoList_SearchButton"
                Label="搜索"
                Click="Search_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE721;"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- ── Photo grid ── -->
        <GridView
            x:Name="PhotoGridView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Photos}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="PhotoGridView_ItemClick"
            Holding="PhotoGridView_Holding"
            ContainerContentChanging="PhotoGridView_ContainerContentChanging"
            SizeChanged="PhotoGridView_SizeChanged"
            ManipulationMode="Scale,System"
            ManipulationDelta="PhotoGridView_ManipulationDelta"
            PointerWheelChanged="PhotoGridView_PointerWheelChanged"
            Padding="4 0 4 24">

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        ItemWidth="180"
                        ItemHeight="180"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Padding"       Value="0"/>
                    <Setter Property="Margin"        Value="2"/>
                    <Setter Property="CornerRadius"  Value="6"/>
                    <Setter Property="MinWidth"      Value="0"/>
                    <Setter Property="MinHeight"     Value="0"/>
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <StaticResource ResourceKey="PhotoCardTemplate"/>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Loading overlay -->
        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48" Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon
                FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                Glyph="&#xEB9F;"
                FontSize="64"
                Opacity="0.3"/>
            <TextBlock
                x:Uid="PhotoList_EmptyTitle"
                Text="相册中还没有照片"
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <TextBlock
                x:Uid="PhotoList_EmptySubtitle"
                Text="暂时没有可显示的照片"
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyTextBlockStyle}"
                Opacity="0.6"/>
        </StackPanel>

        <!-- Card size toast overlay -->
        <Border x:Name="CardSizeToast"
            Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="20,10" CornerRadius="8"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="CardSizeToastText"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Border>
    </Grid>
</Page>
