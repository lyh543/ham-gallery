<Page
    x:Class="FluentGallery.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:conv="using:FluentGallery.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- ConverterParameter="True" inverts the result -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer
        x:Name="SettingsScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Spacing="4" Margin="32,16,32,32">

            <!-- ══════════════════════════════════════════════════════════
                 Status InfoBar — success / info feedback
            ═══════════════════════════════════════════════════════════ -->
            <InfoBar
                x:Name="SuccessBar"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Success"
                IsClosable="True"
                Margin="0,0,0,4"
                Visibility="{x:Bind ViewModel.IsWarningStatus, Converter={StaticResource BoolToVis}, ConverterParameter=True, Mode=OneWay}"
                Closed="StatusBar_Closed" />

            <!-- Warning / error feedback -->
            <InfoBar
                x:Name="WarningBar"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Warning"
                IsClosable="True"
                Margin="0,0,0,4"
                Visibility="{x:Bind ViewModel.IsWarningStatus, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                Closed="StatusBar_Closed" />

            <!-- ══════════════════════════════════════════════════════════
                 1. 扫描目录
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="扫描目录"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Margin="4,8,0,6" />

            <!--
                ItemsSource is bound directly to the ObservableCollection<string>.
                The SettingsExpander's internal ItemsRepeater tracks CollectionChanged
                automatically, so adding/removing items updates the UI immediately.
            -->
            <ctk:SettingsExpander
                Header="扫描目录"
                Description="应用启动后将扫描这些目录中的照片"
                IsExpanded="True"
                ItemsSource="{x:Bind ViewModel.ScanDirectories, Mode=OneWay}">

                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xED25;" />
                </ctk:SettingsExpander.HeaderIcon>

                <!-- Right side of the header row -->
                <Button Content="＋ 添加目录" Click="AddScanDir_Click" />

                <ctk:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <ctk:SettingsCard Header="{x:Bind}">
                            <Button
                                Tag="{x:Bind}"
                                Click="RemoveScanDir_Click"
                                ToolTipService.ToolTip="删除此目录">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                    Glyph="&#xE74D;"
                                    FontSize="14" />
                            </Button>
                        </ctk:SettingsCard>
                    </DataTemplate>
                </ctk:SettingsExpander.ItemTemplate>
            </ctk:SettingsExpander>

            <!-- Exclude dirs -->
            <ctk:SettingsExpander
                Header="排除目录"
                Description="扫描时跳过这些目录（支持绝对路径）"
                IsExpanded="False"
                ItemsSource="{x:Bind ViewModel.ExcludeDirectories, Mode=OneWay}">

                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE711;" />
                </ctk:SettingsExpander.HeaderIcon>

                <Button Content="＋ 添加排除目录" Click="AddExcludeDir_Click" />

                <ctk:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <ctk:SettingsCard Header="{x:Bind}">
                            <Button
                                Tag="{x:Bind}"
                                Click="RemoveExcludeDir_Click"
                                ToolTipService.ToolTip="删除此目录">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                    Glyph="&#xE74D;"
                                    FontSize="14" />
                            </Button>
                        </ctk:SettingsCard>
                    </DataTemplate>
                </ctk:SettingsExpander.ItemTemplate>
            </ctk:SettingsExpander>

            <!-- ══════════════════════════════════════════════════════════
                 2. 外观
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="外观"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Margin="4,16,0,6" />

            <!-- Language -->
            <ctk:SettingsCard
                Header="语言"
                Description="切换语言后需要重新启动应用">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xF2B7;" />
                </ctk:SettingsCard.HeaderIcon>
                <ComboBox
                    SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                    MinWidth="180">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="中文（简体）" />
                </ComboBox>
            </ctk:SettingsCard>

            <!-- Theme -->
            <ctk:SettingsCard
                Header="应用主题"
                Description="立即生效，无需重启">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE771;" />
                </ctk:SettingsCard.HeaderIcon>
                <ComboBox
                    SelectedIndex="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                    MinWidth="180">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                </ComboBox>
            </ctk:SettingsCard>

            <!-- Acrylic backdrop -->
            <ctk:SettingsCard
                Header="亚克力材料"
                Description="使用亚克力效果替代 Mica，立即生效">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xEA80;" />
                </ctk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.UseAcrylicBackdrop, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
            </ctk:SettingsCard>

            <!-- ══════════════════════════════════════════════════════════
                 3. 行为
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="行为"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Margin="4,16,0,6" />

            <!-- Confirm before delete -->
            <ctk:SettingsCard
                Header="删除前确认"
                Description="将照片移入回收站前弹出确认对话框">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74D;" />
                </ctk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.ConfirmBeforeDelete, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
            </ctk:SettingsCard>

            <!-- File associations -->
            <ctk:SettingsCard
                Header="添加文件关联"
                Description="为 JPG、PNG、HEIC 等图片格式注册文件关联（仅对当前用户生效，无需管理员权限）">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A5;" />
                </ctk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.RegisterFileAssociations, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
            </ctk:SettingsCard>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasFileAssociationStatus, Mode=TwoWay}"
                Message="{x:Bind ViewModel.FileAssociationStatusMessage, Mode=OneWay}"
                Severity="Success"
                IsClosable="True"
                Margin="0,2,0,0"
                Visibility="{x:Bind ViewModel.IsFileAssociationWarning, Converter={StaticResource BoolToVis}, ConverterParameter=True, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasFileAssociationStatus, Mode=TwoWay}"
                Message="{x:Bind ViewModel.FileAssociationStatusMessage, Mode=OneWay}"
                Severity="Warning"
                IsClosable="True"
                Margin="0,2,0,0"
                Visibility="{x:Bind ViewModel.IsFileAssociationWarning, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

            <!-- ══════════════════════════════════════════════════════════
                 4. 缓存与数据
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="缓存与数据"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Margin="4,16,0,6" />

            <!-- 缩略图：展开后 第1行打开目录 / 第2行重新生成 / 第3行清除缓存 -->
            <ctk:SettingsExpander
                Header="缩略图"
                Description="{x:Bind ViewModel.ThumbnailExpanderDescription, Mode=OneWay}"
                IsExpanded="False">

                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xEB9F;" />
                </ctk:SettingsExpander.HeaderIcon>

                <ctk:SettingsExpander.Items>

                    <ctk:SettingsCard
                        Header="打开缩略图目录">
                        <Button
                            Content="打开目录"
                            Command="{x:Bind ViewModel.OpenThumbnailsFolderCommand}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="重新生成缩略图"
                        Description="为所有缺失缩略图的照片生成缩略图">
                        <Button
                            Content="立即生成"
                            IsEnabled="{x:Bind ViewModel.ShowGenerateButton, Mode=OneWay}"
                            Command="{x:Bind ViewModel.GenerateMissingThumbnailsCommand}" />
                    </ctk:SettingsCard>

                    <ctk:SettingsCard
                        Header="清除缩略图缓存"
                        Description="下次查看照片时将重新生成">
                        <Button Content="清除缓存" Click="ClearThumbnails_Click" />
                    </ctk:SettingsCard>

                </ctk:SettingsExpander.Items>

            </ctk:SettingsExpander>

            <!-- 生成进度 / 完成动画区（由 code-behind 控制）-->
            <Border
                x:Name="ThumbGenProgressBorder"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20,14"
                Margin="0,2,0,0">
                <Grid>

                    <!-- Building state -->
                    <StackPanel
                        x:Name="ThumbBuildingPanel"
                        Spacing="10"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ThumbnailBuildProgressText, Mode=OneWay}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ThumbnailBuildStatsText, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="取消"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Command="{x:Bind ViewModel.CancelThumbnailBuildCommand}" />
                        </Grid>
                        <ProgressBar
                            Value="{x:Bind ViewModel.ThumbnailBuildProgress, Mode=OneWay}"
                            Maximum="100"
                            IsIndeterminate="{x:Bind ViewModel.IsThumbnailBuildIndeterminate, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Done state — animated from code-behind -->
                    <Grid
                        x:Name="ThumbDonePanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Padding="0,6">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center">

                            <Border
                                Width="52" Height="52"
                                CornerRadius="26"
                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ThumbDoneCircleScale" ScaleX="0" ScaleY="0" />
                                </Border.RenderTransform>
                                <FontIcon
                                    Glyph="&#xE73E;"
                                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                    FontSize="24"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel
                                x:Name="ThumbDoneTextPanel"
                                VerticalAlignment="Center"
                                Opacity="0"
                                RenderTransformOrigin="0,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ThumbDoneTextTranslate" X="20" />
                                </StackPanel.RenderTransform>
                                <TextBlock
                                    Text="全部完成！"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    FontSize="15" />
                                <TextBlock
                                    x:Name="ThumbDoneSubText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    Margin="0,2,0,0" />
                            </StackPanel>

                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <!-- Clear database cache -->
            <ctk:SettingsCard
                Header="清除数据库索引"
                Description="清空照片索引和缩略图记录，照片文件和设置将保留">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8E6;" />
                </ctk:SettingsCard.HeaderIcon>
                <Button Content="清除索引" Click="ClearDbCache_Click" />
            </ctk:SettingsCard>

            <!-- Clear all data -->
            <ctk:SettingsCard
                Header="清除全部数据"
                Description="删除所有应用数据（照片索引、缩略图、设置），恢复出厂状态，照片文件将安全保留">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE894;" />
                </ctk:SettingsCard.HeaderIcon>
                <Button
                    Content="清除全部数据"
                    Click="ClearAll_Click"
                    Foreground="White">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground"            Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#A82219" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="#8B1B14" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled"    Color="#66C42B1C" />
                        <SolidColorBrush x:Key="ButtonForeground"            Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed"     Color="White" />
                    </Button.Resources>
                </Button>
            </ctk:SettingsCard>

            <!-- View logs -->
            <ctk:SettingsCard
                Header="应用日志"
                Description="在文件管理器中打开日志目录（每天一个文件，保留最近 7 天）">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE9F9;" />
                </ctk:SettingsCard.HeaderIcon>
                <Button
                    Content="打开日志目录"
                    Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
            </ctk:SettingsCard>

            <!-- ══════════════════════════════════════════════════════════
                 5. 性能
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="性能"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Margin="4,16,0,6" />

            <!-- Preload count -->
            <ctk:SettingsExpander
                Header="预加载张数"
                Description="预加载更多张数，快速翻看时更流畅，但会占用更多内存"
                IsExpanded="False">
                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8C8;" />
                </ctk:SettingsExpander.HeaderIcon>
                <ctk:SettingsExpander.Items>
                    <ctk:SettingsCard Header="向前预加载张数" Description="额外预加载前方图片">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider
                                Value="{x:Bind ViewModel.PreloadCountBack, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="10"
                                StepFrequency="1"
                                Width="200" />
                            <TextBlock
                                Text="{x:Bind ViewModel.PreloadCountBack, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                MinWidth="20" />
                        </StackPanel>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard Header="向后预加载张数" Description="额外预加载后方图片">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider
                                Value="{x:Bind ViewModel.PreloadCountForward, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="10"
                                StepFrequency="1"
                                Width="200" />
                            <TextBlock
                                Text="{x:Bind ViewModel.PreloadCountForward, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                MinWidth="20" />
                        </StackPanel>
                    </ctk:SettingsCard>
                </ctk:SettingsExpander.Items>
            </ctk:SettingsExpander>

            <!-- Thumbnail size -->
            <ctk:SettingsCard
                Header="缩略图尺寸"
                Description="尺寸越大，缩略图越清晰，但会占用更多存储空间，生成速度也更慢">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xEB9F;" />
                </ctk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider
                        Value="{x:Bind ViewModel.ThumbnailSizeIndex, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="7"
                        StepFrequency="1"
                        IsThumbToolTipEnabled="False"
                        Width="200" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        MinWidth="56">
                        <Run Text="{x:Bind ViewModel.ThumbnailSizePixels, Mode=OneWay}" />
                        <Run Text=" px" />
                    </TextBlock>
                </StackPanel>
            </ctk:SettingsCard>

            <!-- 尺寸变更提示（debounce 后出现）-->
            <InfoBar
                IsOpen="{x:Bind ViewModel.ShowThumbnailSizeHint, Mode=TwoWay}"
                Title="缩略图尺寸已更改"
                Message="历史缩略图将继续以旧尺寸展示，清理缓存后才会按新尺寸重新生成"
                Severity="Warning"
                IsClosable="True"
                Margin="0,4,0,0">
                <InfoBar.ActionButton>
                    <Button Content="立即清理" Click="ClearThumbnailsFromHint_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- ══════════════════════════════════════════════════════════
                 6. 调试
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="调试"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Margin="4,16,0,6" />

            <!-- Force GC -->
            <ctk:SettingsCard
                Header="强制 GC"
                Description="释放非托管内存（WIC 解码面、COM 对象）。切换页面后内存未及时回收时使用。">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE74D;" />
                </ctk:SettingsCard.HeaderIcon>
                <Button Content="立即回收" Click="ForceGC_Click" />
            </ctk:SettingsCard>

            <!-- Show card size toast -->
            <ctk:SettingsCard
                Header="相册缩放时显示尺寸">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A3;" />
                </ctk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.ShowCardSizeToast, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
            </ctk:SettingsCard>

            <!-- Show preload status badges on filmstrip -->
            <ctk:SettingsCard
                Header="显示预加载状态"
                Description="在照片详情页胶片栏缩略图右上角显示预加载进度角标">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xF16C;" />
                </ctk:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.ShowPreloadStatus, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
            </ctk:SettingsCard>

            <!-- ══════════════════════════════════════════════════════════
                 7. 关于
            ═══════════════════════════════════════════════════════════ -->
            <TextBlock
                Text="关于"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Margin="4,16,0,6" />

            <!-- App version -->
            <ctk:SettingsCard
                Header="Fluent Gallery"
                Description="版本 1.0.0">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xEB9F;" />
                </ctk:SettingsCard.HeaderIcon>
            </ctk:SettingsCard>

            <!-- Open-source repository -->
            <ctk:SettingsCard
                Header="开源仓库"
                Description="在 GitHub 上查看源代码、提交 Issue 或贡献代码">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8A7;" />
                </ctk:SettingsCard.HeaderIcon>
                <HyperlinkButton
                    Content="在 GitHub 上查看"
                    NavigateUri="https://github.com/lyh54/ham-gallery" />
            </ctk:SettingsCard>

            <!-- Third-party licenses -->
            <ctk:SettingsCard
                Header="第三方许可证"
                Description="CommunityToolkit.Mvvm · CommunityToolkit.WinUI · EF Core · MetadataExtractor">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE82D;" />
                </ctk:SettingsCard.HeaderIcon>
            </ctk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
