<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <DevBuild Condition="'$(DevBuild)' == '' And '$(Configuration)' == 'Debug'">true</DevBuild>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FluentGallery</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- MSIX packaging mode: pass -p:BuildMsix=true to enable.
       Switches to MSIX package type. app.manifest is retained so PerMonitorV2 DPI awareness
       is embedded into the executable (prevents blurriness on high-DPI displays).
       AppxGeneratePrisForPortableLibrariesEnabled=false disables _GeneratePrisForPortableLibraries
       which tries to run ResGen on all referenced DLLs — unsupported in .NET Core mode (MSB3824). -->
  <PropertyGroup Condition="'$(BuildMsix)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackage>true</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Signing: disabled by default. Pass AppxPackageCertificateKeyFile via CLI for local signing. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <PublishProfile>Properties\PublishProfiles\win10-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>14</LangVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Product>Ham Gallery</Product>
    <AssemblyTitle>Ham Gallery</AssemblyTitle>
    <Description>Ham Gallery</Description>

    <!-- Version Management -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Release/Publish Optimizations -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <!-- Pass -p:DevBuild=true at build time to enable the development environment.
       This defines the DEV_BUILD compile constant, which switches folder names,
       window title, etc. to use a "-Dev" suffix so prod and dev data are isolated. -->
  <PropertyGroup Condition="'$(DevBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);DEV_BUILD</DefineConstants>
    <Product>Ham Gallery (Dev)</Product>
    <AssemblyTitle>Ham Gallery (Dev)</AssemblyTitle>
    <Description>Ham Gallery (Dev)</Description>
  </PropertyGroup>

  <!-- In MSIX mode the MAKEPRI resource compiler rejects DLL contentFiles from
       NuGet packages (BuildHost, SQLite native, etc.) with MSB3824.
       NuGet injects these items during ResolveNuGetPackageAssets, so we remove
       them after that target runs. -->
  <Target Name="RemoveNuGetContentFromMsix" AfterTargets="ResolveNuGetPackageAssets"
          Condition="'$(BuildMsix)' == 'true'">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(FullPath)').Contains('.nuget'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Copy Assets folder to output directory -->
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Copy Strings (localization) folder for WinUI resource loading -->
    <Content Include="Strings\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Temporary suppression for unresolved upstream NuGet advisories in latest stable Magick.NET-Q8-AnyCPU -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8vfj-q2cp-5m5j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-98cp-rj9f-6v5g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pmpg-6pww-fg6q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q8h3-jv9v-57qx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w54j-7wpm-crhj" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-x928-4434-crqj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK (WinUI 3) -->
    <PackageReference Include="ConfigureAwaitChecker.Analyzer" Version="*" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.12.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Community Toolkit WinUI Controls -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="FontAwesome6.Fonts.WinUI" Version="2.5.1" />

    <!-- Dependency Injection & Logging -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

    <!-- Data: EF Core + SQLite -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Image EXIF metadata (will be used in Step 5) -->
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.6" />
  </ItemGroup>

</Project>
