<UserControl
    x:Class="FluentGallery.Controls.AppIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False">

    <Viewbox Width="{x:Bind IconSize, Mode=OneWay}"
             Height="{x:Bind IconSize, Mode=OneWay}">
        <Grid Width="64" Height="64"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="{x:Bind MirrorScaleX, Mode=OneWay}" />
            </Grid.RenderTransform>

            <BitmapIcon UriSource="{x:Bind IconUri, Mode=OneWay}"
                        ShowAsMonochrome="True"
                        Foreground="{x:Bind Foreground, Mode=OneWay}" />
        </Grid>
    </Viewbox>
</UserControl>