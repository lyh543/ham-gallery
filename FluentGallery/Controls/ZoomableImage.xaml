<UserControl
    x:Class="FluentGallery.Controls.ZoomableImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        ZoomableImage: a ScrollViewer wrapping an Image with Stretch="None".
        The image is given explicit Width/Height matching the decoded pixel size so that
        WinUI's built-in pinch-to-zoom (ZoomMode="Enabled") works correctly.

        Double-click  → toggle between "fit to window" and 100 % (original size)
        Mouse wheel   → zoom in / out (no Ctrl required when cursor is over the image)
        Pinch gesture → built-in by ScrollViewer.ZoomMode="Enabled"
    -->
    <Grid>

        <ScrollViewer
            x:Name="Scroll"
            ZoomMode="Enabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden"
            MinZoomFactor="0.1"
            MaxZoomFactor="10"
            Background="Transparent">

            <Image
                x:Name="MainImage"
                Stretch="None"
                DoubleTapped="MainImage_DoubleTapped" />

        </ScrollViewer>

        <!-- Loading indicator — shown while image decodes in background -->
        <ProgressRing
            x:Name="LoadingRing"
            Width="52" Height="52"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <!--
            Zoom slider panel — bottom-right overlay.
            Auto-hides after 3 s of no zoom change and no pointer movement.
            100 % = fit to window (ZoomFactor == _fitZoom).
            Range 25–1000 %, value always a multiple of 5 (stored as int internally).
        -->
        <Border
            x:Name="ZoomSliderContainer"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,12,12"
            CornerRadius="8"
            Padding="6,4"
            Opacity="0"
            Canvas.ZIndex="20"
            RequestedTheme="Dark">

            <Border.Background>
                <AcrylicBrush TintColor="#1E1E1E" TintOpacity="0.85" />
            </Border.Background>

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                <!-- Zoom out: current / 1.25, floor to nearest 5 -->
                <Button x:Name="ZoomOutButton"
                        Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="缩小"
                        Click="ZoomOutButton_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Glyph="&#xE71F;" FontSize="16" />
                </Button>

                <!-- Slider: 25–1000 %, step 5; Minimum/Maximum/Value are set in code-behind -->
                <Slider x:Name="ZoomSlider"
                        SmallChange="5"
                        LargeChange="25"
                        Width="120"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        ValueChanged="ZoomSlider_ValueChanged" />

                <!-- Zoom in: current * 1.25, ceil to nearest 5 -->
                <Button x:Name="ZoomInButton"
                        Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="放大"
                        Click="ZoomInButton_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Glyph="&#xE8A3;" FontSize="16" />
                </Button>

                <!-- Current zoom percentage -->
                <TextBlock x:Name="ZoomPercentText"
                           Text="100%"
                           FontSize="11"
                           Width="38"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />

                <!-- Reset to fit-to-window -->
                <Button x:Name="ZoomResetButton"
                        Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="还原到 100%（适合窗口）"
                        Click="ZoomResetButton_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Glyph="&#xE777;" FontSize="16" />
                </Button>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
