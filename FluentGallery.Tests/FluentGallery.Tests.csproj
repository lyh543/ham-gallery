<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>14</LangVersion>
    <!-- Avoid WinExe entry-point clash when referencing the main project -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- EF Core + SQLite for test helpers -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- MVVM toolkit (needed by SettingsViewModel) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Windows App SDK: provides Windows.Graphics.Imaging and WinRT interop for ThumbnailService tests -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <!-- Magick.NET: needed by MagickImageDecoder (HEIC/HEIF built-in decoder) -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.11.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decoder pipeline (HEIC/HEIF support) -->
    <Compile Include="..\FluentGallery\Decoders\IImageDecoder.cs" />
    <Compile Include="..\FluentGallery\Decoders\WicImageDecoder.cs" />
    <Compile Include="..\FluentGallery\Decoders\MagickImageDecoder.cs" />
    <Compile Include="..\FluentGallery\Decoders\ImageDecoderPipeline.cs" />

    <!-- Reference data-layer source files directly to avoid the WinExe entry point -->
    <Compile Include="..\FluentGallery\Models\Album.cs" />
    <Compile Include="..\FluentGallery\Models\Photo.cs" />
    <Compile Include="..\FluentGallery\Models\Thumbnail.cs" />
    <Compile Include="..\FluentGallery\Models\Setting.cs" />
    <Compile Include="..\FluentGallery\Models\AppSettings.cs" />
    <Compile Include="..\FluentGallery\Models\DeletedPhoto.cs" />
    <Compile Include="..\FluentGallery\Data\GalleryDbContext.cs" />
    <Compile Include="..\FluentGallery\Data\DatabaseService.cs" />
    <Compile Include="..\FluentGallery\Data\ThumbnailService.cs" />
    <!-- SettingsViewModel and its dependencies (no WinUI types) -->
    <Compile Include="..\FluentGallery\Helpers\AppDataPaths.cs" />
    <Compile Include="..\FluentGallery\Services\IThemeService.cs" />
    <Compile Include="..\FluentGallery\ViewModels\SettingsViewModel.cs" />
  </ItemGroup>

  <!-- Test data: images used as regression fixtures -->
  <ItemGroup>
    <Content Include="TestData\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Shared using alias so the test project compiles without the full WinUI namespace tree -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
